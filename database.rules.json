{
  "rules": {
    ".read": false,
    ".write": false,
    "paintFund": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['raised', 'goal'])",
      "raised": { ".validate": "newData.isNumber() && newData.val() >= 0" },
      "goal": { ".validate": "newData.isNumber() && newData.val() >= 1" },
      "$other": { ".validate": false }
    }
  }
}
